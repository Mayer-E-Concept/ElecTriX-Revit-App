<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit 2025 and 2026 both run on .NET 8 and share one common Revit API
    surface, so a single compiled DLL covers both — no multi-targeting
    needed. (Revit 2024 support was dropped; that ran on .NET Framework 4.8,
    a genuinely different runtime that needed its own separate build.)
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>METools</AssemblyName>
    <RootNamespace>METools</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9</LangVersion>
    <Company>Mayer E-Concept SRL</Company>
    <Product>ElecTriX for Autodesk Revit</Product>
    <Copyright>© 2026 Mayer E-Concept SRL</Copyright>
    <!-- MSB3277: Revit's own DLLs (RevitAPI.dll etc.) are built against
         older assembly references than the .NET 8 reference assemblies
         this project targets, so MSBuild always reports a version
         conflict for Microsoft.VisualBasic/System.Drawing here — a
         well-known, expected situation for Revit add-ins on .NET 8, not
         a real problem: Revit's own assembly loader resolves the actual
         version used at runtime regardless of what this build-time
         warning reports. Suppressed rather than "fixed", since there's
         no code change that resolves it — it comes from Revit's own
         SDK DLLs, which this project can't modify. -->
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!--
    Version is normally read from setup.iss (below) at build time, so
    bumping the installer version doesn't ALSO require a separate manual
    edit here. This literal value is only the fallback used if setup.iss
    is missing or its AppVersion line can't be parsed; keep it roughly
    current, but the SyncVersionFromSetupIss target below is what actually
    controls the version on a normal build.
  -->
  <PropertyGroup>
    <Version>2.0.9</Version>
  </PropertyGroup>

  <!--
    Reads #define AppVersion "X.X.X" out of setup.iss and applies it to
    Version/AssemblyVersion/FileVersion, so setup.iss stays the single
    source of truth for the version number. Runs before the properties are
    consumed (CoreCompile/GetAssemblyVersion write them into the compiled
    assembly). If setup.iss is missing or the line doesn't match the
    expected format, this warns and leaves the fallback <Version> above in
    place rather than failing the build.

    This exists because the two fields drifted once already (csproj said
    1.6.0 while setup.iss/commits were already at 2.0.6) purely from being
    two separate manual edits; this target removes that failure mode
    rather than just fixing that one instance of it.
  -->
  <Target Name="SyncVersionFromSetupIss" BeforeTargets="BeforeBuild;CoreCompile;GetAssemblyVersion">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\setup.iss"
                        Condition="Exists('$(MSBuildProjectDirectory)\setup.iss')">
      <Output TaskParameter="Lines" ItemName="_SetupIssLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_SetupIssJoined>@(_SetupIssLines, '%0a')</_SetupIssJoined>
      <_IssVersionMatch>$([System.Text.RegularExpressions.Regex]::Match($(_SetupIssJoined), 'AppVersion\s+"[^"]*?(\d+(?:\.\d+)+)"').Groups[1].Value)</_IssVersionMatch>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_IssVersionMatch)' != ''">
      <Version>$(_IssVersionMatch)</Version>
      <AssemblyVersion>$(_IssVersionMatch).0</AssemblyVersion>
      <FileVersion>$(_IssVersionMatch).0</FileVersion>
    </PropertyGroup>
    <Warning Condition="'$(_IssVersionMatch)' == ''"
             Text="Could not read AppVersion from setup.iss -- keeping the fallback &lt;Version&gt; ($(Version)) instead. Check the '#define AppVersion &quot;X.X.X&quot;' line's format." />
    <Message Condition="'$(_IssVersionMatch)' != ''" Text="Version synced from setup.iss: $(_IssVersionMatch)" Importance="high" />
  </Target>

  <!-- Revit API references — links against a Revit 2025 install (used at
       runtime for 2026 too). Adjust these HintPaths if your install lives
       elsewhere. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="standard_worksets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>config\standard_worksets.json</TargetPath>
    </None>
    <EmbeddedResource Include="Icons\*.png" />
    <EmbeddedResource Include="setup.iss" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Icons\" />
  </ItemGroup>

  <!-- Nach jedem Build: DLL signieren (wenn Zertifikat existiert) -->
  <Target Name="SignAssembly" AfterTargets="Build">
    <PropertyGroup>
      <CertPath>$(ProjectDir)signing\mec-codesign.pfx</CertPath>
      <CertPassword>$(MEC_CERT_PASSWORD)</CertPassword>
      <TimestampUrl>http://timestamp.digicert.com</TimestampUrl>
    </PropertyGroup>
    <!-- signtool.exe aus Windows SDK — mehrere bekannte Pfade probieren -->
    <Exec Condition="Exists('$(CertPath)')"
          Command="for %%F in (&quot;C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe&quot; &quot;C:\Program Files (x86)\Windows Kits\10\bin\10.0.22000.0\x64\signtool.exe&quot; &quot;C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\signtool.exe&quot; &quot;C:\Program Files (x86)\Windows Kits\10\bin\x64\signtool.exe&quot;) do if exist %%F ( %%F sign /f &quot;$(CertPath)&quot; /p $(CertPassword) /fd SHA256 /tr $(TimestampUrl) /td SHA256 &quot;$(TargetPath)&quot; &amp; exit /b 0 )"
          ContinueOnError="true" />
    <Message Condition="Exists('$(CertPath)')" Text="✓ Signed: $(TargetPath)" Importance="high" />
    <Message Condition="!Exists('$(CertPath)')" Text="⚠ Nicht signiert — setup-signing.ps1 zuerst ausführen." Importance="high" />
    <Warning Condition="Exists('$(CertPath)') and '$(MEC_CERT_PASSWORD)' == ''"
             Text="Zertifikat gefunden, aber Umgebungsvariable MEC_CERT_PASSWORD ist nicht gesetzt -- Signieren wird fehlschlagen. Einmalig setzen: setx MEC_CERT_PASSWORD &quot;dein-passwort&quot; (dann VS/Terminal neu starten)." />
  </Target>

  <!--
    Nach jedem Build: DLL + addin automatisch nach ProgramData kopieren, in
    BEIDE Revit-Versionsordner (2025 und 2026 — dieselbe Binary für beide).
  -->
  <Target Name="DeployToRevit" AfterTargets="SignAssembly">

    <PropertyGroup>
      <RevitAddinsDir2025>C:\ProgramData\Autodesk\Revit\Addins\2025</RevitAddinsDir2025>
      <RevitAddinsDir2026>C:\ProgramData\Autodesk\Revit\Addins\2026</RevitAddinsDir2026>
    </PropertyGroup>

    <!-- ── Revit 2025 ────────────────────────────────────────────────────── -->
    <MakeDir Directories="$(RevitAddinsDir2025)\Icons" ContinueOnError="true" />
    <MakeDir Directories="$(RevitAddinsDir2025)\config" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)METools.dll" DestinationFolder="$(RevitAddinsDir2025)"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <PropertyGroup>
      <_Dll2025Ok>$(MSBuildLastTaskResult)</_Dll2025Ok>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)METools_2025.addin" DestinationFiles="$(RevitAddinsDir2025)\METools.addin"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <PropertyGroup>
      <_Addin2025Ok>$(MSBuildLastTaskResult)</_Addin2025Ok>
    </PropertyGroup>
    <Copy SourceFiles="@(EmbeddedResource)" DestinationFolder="$(RevitAddinsDir2025)\Icons"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)config\standard_worksets.json" DestinationFolder="$(RevitAddinsDir2025)\config"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <!-- Only the DLL and .addin manifest are checked here — those are the
         two files that actually determine what Revit loads and runs; the
         icons/worksets copies above can fail without anyone ending up
         running a stale build, which is the specific confusion this check
         exists to catch. -->
    <Message Condition="'$(_Dll2025Ok)' == 'true' and '$(_Addin2025Ok)' == 'true'"
              Text="✓ ME-Tools deployed to $(RevitAddinsDir2025)" Importance="high" />
    <Warning Condition="'$(_Dll2025Ok)' != 'true' or '$(_Addin2025Ok)' != 'true'"
             Text="Deploy to $(RevitAddinsDir2025) did NOT fully succeed (see the MSB3021 warning above for which file and why -- usually Revit 2025 is open right now, locking it). The ribbon there is still running whatever build it loaded last, not this one, until Revit is closed and this is rebuilt." />

    <!-- ── Revit 2026 (same DLL, second folder) ─────────────────────────── -->
    <MakeDir Directories="$(RevitAddinsDir2026)\Icons" ContinueOnError="true" />
    <MakeDir Directories="$(RevitAddinsDir2026)\config" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)METools.dll" DestinationFolder="$(RevitAddinsDir2026)"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <PropertyGroup>
      <_Dll2026Ok>$(MSBuildLastTaskResult)</_Dll2026Ok>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)METools_2026.addin" DestinationFiles="$(RevitAddinsDir2026)\METools.addin"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <PropertyGroup>
      <_Addin2026Ok>$(MSBuildLastTaskResult)</_Addin2026Ok>
    </PropertyGroup>
    <Copy SourceFiles="@(EmbeddedResource)" DestinationFolder="$(RevitAddinsDir2026)\Icons"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)config\standard_worksets.json" DestinationFolder="$(RevitAddinsDir2026)\config"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Message Condition="'$(_Dll2026Ok)' == 'true' and '$(_Addin2026Ok)' == 'true'"
              Text="✓ ME-Tools also deployed to $(RevitAddinsDir2026)" Importance="high" />
    <Warning Condition="'$(_Dll2026Ok)' != 'true' or '$(_Addin2026Ok)' != 'true'"
             Text="Deploy to $(RevitAddinsDir2026) did NOT fully succeed (see the MSB3021 warning above for which file and why -- usually Revit 2026 is open right now, locking it). The ribbon there is still running whatever build it loaded last, not this one, until Revit is closed and this is rebuilt." />

  </Target>

</Project>
